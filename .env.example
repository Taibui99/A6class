# Neon (project: A6class / snowy-fire-56923018)
# - DATABASE_URL: pooled (PgBouncer) — dùng cho app runtime, serverless
# - DATABASE_URL_UNPOOLED: direct — dùng cho migrations (Prisma directUrl), dumps
# - NEON_AUTH_BASE_URL / NEON_AUTH_JWKS_URL: sinh tự động bởi `neon deploy` + `neon env pull`
# Các biến này do `neon env pull` quản lý — đừng sửa tay
NEON_BRANCH=production
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.PROJECT.REGION.aws.neon.tech/DATABASE?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@HOST.PROJECT.REGION.aws.neon.tech/DATABASE?sslmode=require"
NEON_AUTH_BASE_URL="https://HOST.neonauth.REGION.aws.neon.tech/DATABASE/auth"

# Neon Auth (Managed Better Auth) — app-side, sinh thủ công (>=32 chars)
NEON_AUTH_COOKIE_SECRET="your-cookie-secret-at-least-32-chars"

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=A6Class