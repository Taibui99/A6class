generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================
// USERS & AUTH
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  fullName      String
  avatarUrl     String?
  phone         String?
  dateOfBirth   DateTime?
  role          UserRole  @default(STUDENT)
  status        UserStatus @default(ACTIVE)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  memberships    ClassMembership[]
  ownedTeams     Team[]            @relation("TeamLeader")
  viceTeams      Team[]            @relation("TeamViceLeader")
  tasks          Task[]            @relation("TaskCreator")
  assignments    TaskAssignment[]
  submissions    TaskSubmission[]
  points         PointTransaction[] @relation("PointTarget")
  givenPoints    PointTransaction[] @relation("PointGiver")
  achievements   UserAchievement[]
  posts          Post[]
  comments       Comment[]
  reactions      Reaction[]
  questions      Question[]
  answers        Answer[]
  sentMessages   Message[]         @relation("MessageSender")
  reviewedSubmissions TaskSubmission[] @relation("SubmissionReviewer")
  conversations  ConversationMember[]
  notifications  Notification[]
  reports        Report[]          @relation("ReportCreator")
  announcements  Announcement[]
}

enum UserRole {
  TEACHER
  STUDENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

// ============================================
// CLASS MANAGEMENT
// ============================================

model Class {
  id          String   @id @default(cuid())
  name        String
  schoolYear  String
  school      String?
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  memberships        ClassMembership[]
  teams              Team[]
  tasks              Task[]
  posts              Post[]
  questions          Question[]
  conversations      Conversation[]
  announcements      Announcement[]
  competitionPeriods CompetitionPeriod[]
  pointTransactions  PointTransaction[]
  reports            Report[]
}

model ClassMembership {
  id        String     @id @default(cuid())
  userId    String
  classId   String
  role      MemberRole @default(STUDENT)
  teamId    String?
  joinedAt  DateTime   @default(now())

  user      User       @relation(fields: [userId], references: [id])
  class     Class      @relation(fields: [classId], references: [id])
  team      Team?      @relation(fields: [teamId], references: [id])

  @@unique([userId, classId])
}

enum MemberRole {
  CLASS_MONITOR
  ACADEMIC_VICE_MONITOR
  ACTIVITY_VICE_MONITOR
  LABOR_VICE_MONITOR
  TEAM_LEADER
  TEAM_VICE_LEADER
  STUDENT
}

// ============================================
// TEAM SYSTEM
// ============================================

model Team {
  id           String   @id @default(cuid())
  classId      String
  name         String
  color        String?
  leaderId     String?
  viceLeaderId String?
  totalScore   Int      @default(0)
  rank         Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class            Class               @relation(fields: [classId], references: [id])
  leader           User?               @relation("TeamLeader", fields: [leaderId], references: [id])
  viceLeader       User?               @relation("TeamViceLeader", fields: [viceLeaderId], references: [id])
  members          ClassMembership[]
  tasks            Task[]
  pointTransactions PointTransaction[]
  achievements     TeamAchievement[]
  rankHistory      RankHistory[]
}

// ============================================
// TASK SYSTEM
// ============================================

model Task {
  id           String       @id @default(cuid())
  classId      String
  creatorId    String
  title        String
  description  String?
  deadline     DateTime?
  priority     TaskPriority @default(MEDIUM)
  status       TaskStatus   @default(TODO)
  points       Int?
  assigneeType AssigneeType @default(INDIVIDUAL)
  teamId       String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  class       Class             @relation(fields: [classId], references: [id])
  creator     User              @relation("TaskCreator", fields: [creatorId], references: [id])
  team        Team?             @relation(fields: [teamId], references: [id])
  assignments TaskAssignment[]
  submissions TaskSubmission[]
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  SUBMITTED
  REVIEWING
  COMPLETED
  REJECTED
}

enum AssigneeType {
  INDIVIDUAL
  TEAM
  CLASS
  ROLE
}

model TaskAssignment {
  id     String     @id @default(cuid())
  taskId String
  userId String
  status TaskStatus @default(TODO)

  task Task @relation(fields: [taskId], references: [id])
  user User @relation(fields: [userId], references: [id])

  @@unique([taskId, userId])
}

model TaskSubmission {
  id           String           @id @default(cuid())
  taskId       String
  userId       String
  content      String?
  fileUrls     String[]
  status       SubmissionStatus @default(PENDING)
  reviewerId   String?
  reviewNote   String?
  submittedAt  DateTime         @default(now())
  reviewedAt   DateTime?

  task     Task  @relation(fields: [taskId], references: [id])
  user     User  @relation(fields: [userId], references: [id])
  reviewer User? @relation("SubmissionReviewer", fields: [reviewerId], references: [id])
}

enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ============================================
// COMPETITION SYSTEM
// ============================================

model CompetitionPeriod {
  id        String   @id @default(cuid())
  classId   String
  name      String
  startDate DateTime
  endDate   DateTime
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  class        Class              @relation(fields: [classId], references: [id])
  transactions PointTransaction[]
}

model PointTransaction {
  id           String   @id @default(cuid())
  classId      String
  targetUserId String?
  targetTeamId String?
  amount       Int
  reason       String
  category     String?
  giverId      String
  periodId     String?
  note         String?
  evidenceUrls String[]
  createdAt    DateTime @default(now())

  class      Class               @relation(fields: [classId], references: [id])
  targetUser User?               @relation("PointTarget", fields: [targetUserId], references: [id])
  targetTeam Team?               @relation(fields: [targetTeamId], references: [id])
  giver      User                @relation("PointGiver", fields: [giverId], references: [id])
  period     CompetitionPeriod?  @relation(fields: [periodId], references: [id])
}

model RankHistory {
  id       String   @id @default(cuid())
  teamId   String
  periodId String?
  rank     Int
  score    Int
  date     DateTime @default(now())

  team Team @relation(fields: [teamId], references: [id])
}

// ============================================
// ACHIEVEMENTS
// ============================================

model Achievement {
  id          String            @id @default(cuid())
  title       String
  description String
  icon        String
  rarity      AchievementRarity @default(COMMON)
  condition   Json?
  createdAt   DateTime          @default(now())

  userAchievements UserAchievement[]
  teamAchievements TeamAchievement[]
}

enum AchievementRarity {
  COMMON
  UNCOMMON
  RARE
  EPIC
  LEGENDARY
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([userId, achievementId])
}

model TeamAchievement {
  id            String   @id @default(cuid())
  teamId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  team        Team        @relation(fields: [teamId], references: [id])
  achievement Achievement @relation(fields: [achievementId], references: [id])

  @@unique([teamId, achievementId])
}

// ============================================
// CLASS FEED
// ============================================

model Post {
  id        String   @id @default(cuid())
  classId   String
  authorId  String
  content   String
  imageUrls String[]
  isPinned  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class    Class     @relation(fields: [classId], references: [id])
  author   User      @relation(fields: [authorId], references: [id])
  comments Comment[]
  reactions Reaction[]
}

model Comment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    Post      @relation(fields: [postId], references: [id])
  author  User      @relation(fields: [authorId], references: [id])
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id])
  replies Comment[] @relation("CommentReplies")
  reactions Reaction[]
}

model Reaction {
  id        String       @id @default(cuid())
  userId    String
  postId    String?
  commentId String?
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  user    User     @relation(fields: [userId], references: [id])
  post    Post?    @relation(fields: [postId], references: [id])
  comment Comment? @relation(fields: [commentId], references: [id])

  @@unique([userId, postId])
  @@unique([userId, commentId])
}

enum ReactionType {
  LIKE
  LOVE
  CELEBRATE
  INSIGHTFUL
}

// ============================================
// QUESTIONS / HELP
// ============================================

model Question {
  id               String   @id @default(cuid())
  classId          String
  authorId         String
  title            String
  content          String
  imageUrls        String[]
  isResolved       Boolean  @default(false)
  acceptedAnswerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  class   Class    @relation(fields: [classId], references: [id])
  author  User     @relation(fields: [authorId], references: [id])
  answers Answer[]
}

model Answer {
  id         String   @id @default(cuid())
  questionId String
  authorId   String
  content    String
  imageUrls  String[]
  isAccepted Boolean  @default(false)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  question Question @relation(fields: [questionId], references: [id])
  author   User     @relation(fields: [authorId], references: [id])
}

// ============================================
// CHAT / MESSAGING
// ============================================

model Conversation {
  id        String             @id @default(cuid())
  classId   String?
  type      ConversationType   @default(DIRECT)
  name      String?
  createdAt DateTime           @default(now())
  updatedAt DateTime           @updatedAt

  class   Class?                @relation(fields: [classId], references: [id])
  members ConversationMember[]
  messages Message[]
}

enum ConversationType {
  DIRECT
  TEAM
  CLASS
}

model ConversationMember {
  id             String   @id @default(cuid())
  conversationId String
  userId         String
  lastReadAt     DateTime?
  joinedAt       DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@unique([conversationId, userId])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  content        String
  type           MessageType @default(TEXT)
  fileUrls       String[]
  voiceUrl       String?
  voiceDuration  Int?
  replyToId      String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  conversation Conversation @relation(fields: [conversationId], references: [id])
  sender       User         @relation("MessageSender", fields: [senderId], references: [id])
  replyTo      Message?     @relation("MessageReplies", fields: [replyToId], references: [id])
  replies      Message[]    @relation("MessageReplies")
}

enum MessageType {
  TEXT
  IMAGE
  VOICE
  FILE
  SYSTEM
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String           @id @default(cuid())
  userId    String
  type      NotificationType
  title     String
  content   String?
  link      String?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id])
}

enum NotificationType {
  NEW_TASK
  DEADLINE_APPROACHING
  NEW_MESSAGE
  MENTION
  POINT_GAINED
  POINT_LOST
  ACHIEVEMENT_UNLOCKED
  LEADERBOARD_MOVEMENT
  ANNOUNCEMENT
  ROLE_ASSIGNMENT
  TASK_REVIEW
  ACCEPTED_ANSWER
}

// ============================================
// ANNOUNCEMENTS
// ============================================

model Announcement {
  id        String                @id @default(cuid())
  classId   String
  authorId  String
  title     String
  content   String
  priority  AnnouncementPriority @default(NORMAL)
  isPinned  Boolean              @default(false)
  expiresAt DateTime?
  createdAt DateTime             @default(now())

  class  Class @relation(fields: [classId], references: [id])
  author User  @relation(fields: [authorId], references: [id])
}

enum AnnouncementPriority {
  LOW
  NORMAL
  HIGH
  URGENT
}

// ============================================
// REPORTS
// ============================================

model Report {
  id           String       @id @default(cuid())
  classId      String
  creatorId    String
  type         ReportType
  title        String
  content      String
  stats        Json?
  evidenceUrls String[]
  status       ReportStatus @default(DRAFT)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  class   Class @relation(fields: [classId], references: [id])
  creator User  @relation("ReportCreator", fields: [creatorId], references: [id])
}

enum ReportType {
  DAILY
  WEEKLY
  TEAM
  ACADEMIC
  ACTIVITY
  LABOR
  INCIDENT
}

enum ReportStatus {
  DRAFT
  SUBMITTED
  REVIEWED
  ARCHIVED
}
